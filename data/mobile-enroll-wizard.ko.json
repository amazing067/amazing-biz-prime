{
  "meta": { "title": "Mobile Enrollment Wizard", "version": "1.1" },
  "steps": [
    {
      "id": "s01",
      "title": "상품 주요 설명 사항 확인",
      "subtitle": "설명 듣고 이해 여부 체크",
      "trainerNotes": [
        "목표: '설명했다'가 아니라 '이해 확인'까지.",
        "긴 설명 금지. 체크 중심으로 진행."
      ],
      "complianceNotes": [
        "핵심 설명사항은 체크 기반으로 남기는 것이 분쟁 예방에 유리함."
      ],
      "fields": [
        { "id": "explain_withdrawal", "label": "청약철회(기한/방법/효과) 설명 및 이해", "type": "checkbox" },
        { "id": "explain_cancel", "label": "계약 해제/해지 및 위법계약 해지 설명 및 이해", "type": "checkbox" },
        { "id": "explain_complaint", "label": "민원 처리 및 분쟁조정 절차 설명 및 이해", "type": "checkbox" },
        { "id": "explain_deposit", "label": "예금자보호 여부 및 내용 설명 및 이해", "type": "checkbox" },
        { "id": "explain_affiliate", "label": "연계/제휴 서비스(변경 사유/사전고지) 설명 및 이해", "type": "checkbox" },
        { "id": "explain_mainrisk", "label": "주된/부수 위험보장 및 보험료·보험금(지급 제한/절차 포함) 설명 및 이해", "type": "checkbox" },
        { "id": "explain_term", "label": "위험보장 기간 및 보험료 납입기간 설명 및 이해", "type": "checkbox" },
        { "id": "explain_refund", "label": "해약/만기 환급금 및 산출근거(환급금이 없거나 적을 수 있음 포함) 설명 및 이해", "type": "checkbox" },
        { "id": "explain_invalid", "label": "계약의 취소/무효 사항 설명 및 이해", "type": "checkbox" },
        { "id": "explain_disclosure_effect", "label": "고지/통지의무 위반 시 불이익(해지/보장 제한 등) 설명 및 이해", "type": "checkbox" }
      ]
    },
    {
      "id": "s02",
      "title": "보험가입서류 전달/수령 확인",
      "subtitle": "청약서/약관/상품설명서 전달 및 열람 확인",
      "trainerNotes": [
        "QR/모바일 링크로 받는 경우: '열람 + 저장'이 됐는지 확인.",
        "고객이 지금 열 수 없으면, 다음 단계로 진행하지 않음."
      ],
      "complianceNotes": [
        "약관을 QR/모바일 링크로 수령한 경우, 고객이 링크를 열어 저장하도록 안내 필요."
      ],
      "fields": [
        { "id": "doc_app_copy", "label": "계약자 보관용 청약서 전달", "type": "checkbox" },
        { "id": "doc_terms", "label": "보험약관 전달(또는 QR/모바일 링크)", "type": "checkbox" },
        { "id": "doc_guide", "label": "상품설명서 전달", "type": "checkbox" },
        {
          "id": "doc_open_save",
          "label": "고객이 약관을 열람하고 저장했는지",
          "type": "radio",
          "options": ["예", "아니오(열람/저장 완료 후 진행)"]
        }
      ]
    },
    {
      "id": "s03",
      "title": "출금이체 신청 동의(수집·이용)",
      "subtitle": "보험료 수납 목적의 필수 동의",
      "trainerNotes": [
        "이 단계는 '필수 동의' 성격이므로 거부 시 진행이 어려울 수 있음.",
        "민감정보를 메신저로 받지 말고, 고객 화면에서 직접 입력."
      ],
      "complianceNotes": [
        "출금이체 수집·이용은 필수적 사항일 수 있으며, 보유기간(종료 후 5년 등)을 안내."
      ],
      "fields": [
        {
          "id": "auto_debit_required_notice",
          "label": "출금이체 동의가 없으면 수납/유지가 어려울 수 있음을 안내",
          "type": "checkbox"
        },
        { "id": "consent_collect_use", "label": "개인(신용)정보 수집·이용 동의(출금이체)", "type": "checkbox" },
        {
          "id": "retention_ack",
          "label": "보유·이용기간(출금이체 종료/해지 후 일정기간 보관) 안내 확인",
          "type": "checkbox"
        }
      ]
    },
    {
      "id": "s04",
      "title": "출금이체 신청 동의(제공)",
      "subtitle": "금융결제원/VAN 등 제공 동의",
      "trainerNotes": [
        "제공 목적은 '출금동의 확인/등록/해지 통지' 등으로 설명.",
        "고객이 불안해하면 '수납 처리를 위한 표준 절차'로 짧게 정리."
      ],
      "complianceNotes": [
        "출금이체 처리 목적의 제공 동의가 필요할 수 있음."
      ],
      "fields": [
        { "id": "consent_provide", "label": "개인(신용)정보 제공 동의(출금이체 처리)", "type": "checkbox" },
        {
          "id": "provider_ack",
          "label": "제공받는 기관/목적 안내 확인",
          "type": "checkbox"
        }
      ]
    },
    {
      "id": "s05",
      "title": "출금이체 정보 입력(예시)",
      "subtitle": "교육용 입력(실제값 입력 금지)",
      "trainerNotes": [
        "교육 환경에서는 실제 계좌번호/실명 입력 금지.",
        "실전에서는 고객이 본인 화면에서 직접 입력하도록 유도."
      ],
      "complianceNotes": [
        "민감 정보는 안전한 채널/화면에서만 처리."
      ],
      "fields": [
        { "id": "bank_name", "label": "금융기관명(예시)", "type": "text", "placeholder": "Example Bank" },
        { "id": "account_masked", "label": "계좌번호(예시, 마스킹)", "type": "text", "placeholder": "123-****-****" },
        { "id": "payer_name", "label": "예금주(예시)", "type": "text", "placeholder": "Example Name" },
        { "id": "billing_confirm", "label": "출금 동의/명의 확인 완료", "type": "checkbox" }
      ]
    },
    {
      "id": "s06",
      "title": "고지의무(서면 질문 기반) - 핵심",
      "subtitle": "질문 문구대로 사실 확인",
      "trainerNotes": [
        "가장 사고가 많이 나는 구간.",
        "질문을 '요약'하지 말고, 문구대로 읽고 사실만 확인."
      ],
      "complianceNotes": [
        "보험회사가 서면으로 질문한 중요한 사항에 사실대로 기재하고 서명(전자서명 포함)이 필요.",
        "설계사에게 구두로만 알린 내용은 효력이 없을 수 있음."
      ],
      "fields": [
        {
          "id": "disclosure_read_question",
          "label": "질문 문구대로 읽고 확인했다",
          "type": "checkbox"
        },
        {
          "id": "disclose_medical",
          "label": "병원 내원/검사/약/치료 관련(질문 기간 기준)",
          "type": "radio",
          "options": ["해당 없음", "해당 있음(중단 후 세부 확인/증빙)"]
        },
        {
          "id": "disclose_surgery_dx",
          "label": "진단/수술/입원 이력 관련(질문 기간 기준)",
          "type": "radio",
          "options": ["해당 없음", "해당 있음(중단 후 세부 확인/증빙)"]
        },
        {
          "id": "disclose_job_hobby",
          "label": "직업/고위험 취미 등 중요한 사항",
          "type": "radio",
          "options": ["해당 없음", "해당 있음(정확히 반영)"]
        },
        {
          "id": "verify_first",
          "label": "확정 표현 금지(‘기준 확인 후 안내’ 사용)",
          "type": "checkbox"
        },
        {
          "id": "complaint_case_ack",
          "label": "구두 고지만으로는 분쟁 위험(민원 사례) 안내 완료",
          "type": "checkbox"
        }
      ]
    },
    {
      "id": "s07",
      "title": "최종 확인 및 전자서명",
      "subtitle": "서명 전 마지막 재확인",
      "trainerNotes": [
        "서명 직전 30초 재확인이 분쟁을 줄임.",
        "고객이 직접 서명(대리 서명 금지)."
      ],
      "complianceNotes": [
        "전자서명 포함, 본인 작성/서명 원칙."
      ],
      "fields": [
        { "id": "final_recheck", "label": "고지 항목 재확인 완료", "type": "checkbox" },
        { "id": "docs_reconfirm", "label": "서류 수령/열람 재확인 완료", "type": "checkbox" },
        { "id": "signed_by_customer", "label": "고객 본인 전자서명 완료", "type": "checkbox" }
      ]
    },
    {
      "id": "s08",
      "title": "청약 제출 완료",
      "subtitle": "모니터링/증권전달/리뷰 안내",
      "trainerNotes": [
        "모니터링은 '청약서에 표시한 내용 그대로'가 원칙.",
        "증권 전달 후 7/30/90 리뷰 약속을 잡으면 유지율이 올라감."
      ],
      "complianceNotes": [
        "모니터링 질문이 애매하면 추측 금지, 확인 후 답변."
      ],
      "fields": [
        { "id": "monitoring_explained", "label": "모니터링 대응 안내 완료", "type": "checkbox" },
        { "id": "policy_delivery_explained", "label": "증권/요약서 전달 안내 완료", "type": "checkbox" },
        { "id": "review_scheduled", "label": "리뷰 일정(7/30/90) 안내/확정", "type": "checkbox" }
      ]
    }
  ],
  "monitoringScripts": {
    "do": [
      "청약서에 체크한 내용 그대로 답변",
      "애매하면 '확인 후 답변' (추측 금지)",
      "사실관계 일관성 유지"
    ],
    "dont": [
      "병력/치료 사실 축소 또는 누락",
      "'무조건 승인' 표현",
      "청약 후 임의로 답변 변경"
    ]
  },
  "policyDeliveryScripts": [
    "청약 완료되었습니다. 증권/요약서를 전달드립니다. 핵심 3가지는 (1) ___ (2) ___ (3) ___.",
    "모니터링 전화가 오면 청약서 표시 내용 그대로 답변하시고, 애매하면 확인 후 답변이라고 말씀하세요.",
    "7일/30일/90일 짧은 리뷰로 중복/공백을 한 번 더 점검하겠습니다."
  ]
}
